{
  "name": "almsby",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "supabase start && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "scan:a11y": "node scripts/a11y-scan.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:validate": "dotenv -e .env.local -- prisma validate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@prisma/client": "^6.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.49.0",
    "bwip-js": "^4.11.4",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.5.0",
    "prisma": "^6.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
