# Almsby - example environment variables
#
# LOCAL DEV uses the Supabase CLI (see README "Local development"): run
# `supabase start` (Docker required), then copy the values from `supabase status`
# into the "--- Local ---" block below in your .env.local.
#
# HOSTED (Vercel app per environment + GitHub Actions secrets) uses the
# "--- Hosted ---" block values, sourced from the password manager.

# --- Local (Supabase CLI via `supabase start`) ---
# Defaults exposed by the local stack (confirm with `supabase status`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from supabase status>
#   SUPABASE_SECRET_KEY=<service_role key from supabase status>   # or SUPABASE_SERVICE_ROLE_KEY
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Hosted (Supabase projects for staging + production) ---
# --- Public URLs (build-time; inlined into the client bundle) ---
NEXT_PUBLIC_APP_URL=https://your-app-domain.example
# Resolver domain (issues #5/#17): distinct from the app URL; the ONLY base
# allowed for GS1 Digital Link URIs. Real values per environment:
#   production: https://id.almsby.com
#   staging:    https://id.staging.almsby.com
# NEVER a localhost / 127.0.0.1 / *.vercel.app placeholder in a deployed env —
# lib/env.ts fails the URL guard (and instrumentation.ts fails boot) if one is.
NEXT_PUBLIC_RESOLVER_URL=https://your-resolver-domain.example

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:your-password@your-host:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@your-host:5432/postgres

# --- Supabase ---
# Project URL + publishable key (safe for browser/client; replaces the old anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only secret key (admin, bypasses RLS). Optional for Phase 0 core flows.
# Set either this (preferred) or the legacy SUPABASE_SERVICE_ROLE_KEY:
# SUPABASE_SECRET_KEY=your-secret-key

# --- Cloudflare R2 (story-page photo storage, #71) ---
# Server-only. R2 is the zero-egress storage choice for story pages (the
# highest-traffic surface in the product). Create an API token with Object
# Read & Write on the story-photos bucket, and set R2_PUBLIC_DOMAIN to the
# public hostname the bucket is served under (a custom CNAME is fine; small
# custom-domain support keeps the option open without a code change).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_DOMAIN=images.your-domain.example
