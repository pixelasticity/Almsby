{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Almsby Browser Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "provider",
    "route",
    "viewport",
    "started_at",
    "finished_at",
    "result",
    "artifacts",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "unknown"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "unknown"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "actions": {
      "type": "array"
    },
    "locale": {
      "type": "string"
    }
  },
  "additionalProperties": true
}