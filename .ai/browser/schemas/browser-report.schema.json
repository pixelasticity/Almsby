{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Browser Validation Report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "checked_at",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "checked_at": {
      "type": "string"
    },
    "scenarios": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    }
  },
  "additionalProperties": true
}